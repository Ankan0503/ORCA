# Copy to .env and fill in. Only SARVAM_API_KEY is needed to run the voice and
# language features; without GROQ_API_KEY the orchestrator falls back to a
# deterministic rule-based planner so the API still works end to end.

# Sarvam AI — speech-to-text, text-to-speech, translation (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Groq — reasoning / planning LLM (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated origins allowed to call this API (CORS).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.29.43:3000,http://localhost:5173,http://127.0.0.1:5173,http://192.168.29.43:5173
# Regex to allow any local network IP / mobile phone origin
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+)(:\d+)?$

# External API and Service Endpoints (overridable via .env)
# INCOIS Marine Fisheries Advisory
INCOIS_TEXTDATA_URL=https://incois.gov.in/MarineFisheries/TextData
INCOIS_TEXTDATA_HOME_URL=https://incois.gov.in/MarineFisheries/TextDataHome
INCOIS_PFZ_LINES_WFS_URL=https://incois.gov.in/geoserver/PFZ_Automation/ows?service=WFS&version=1.1.0&request=GetFeature&typeName=PFZ_Automation:pfzlines&outputFormat=application/json

# NOAA CoastWatch ERDDAP (gap-filled VIIRS chlorophyll-a)
NOAA_ERDDAP_URL=https://coastwatch.noaa.gov/erddap/griddap/noaacwNPPN20S3ASCIDINEOF2kmDaily.json

# Open-Meteo Marine & Weather APIs
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Reverse Geocoding Services
BIGDATACLOUD_REVERSE_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse


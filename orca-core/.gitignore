# The archive is collected data, not source. It rebuilds itself from the
# scrapers that already run, and on a host with an ephemeral filesystem it is
# discarded on restart anyway — use /api/archive/export to keep a run's worth.
data/archive.sqlite3
data/archive.sqlite3-wal
data/archive.sqlite3-shm

# Copernicus Marine downloads: fetched data, rebuilt every morning, and tens of
# megabytes of NetCDF. The published zone file is deliberately NOT ignored — the
# API serves it straight from disk, and the host it runs on has neither the
# pipeline's dependencies nor a disk that survives a restart, so a file that is
# only ever generated locally leaves the deployed map empty.
data/copernicus_raw/
data/copernicus_last_clear.json

.env
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Raw Open-Meteo responses for the ML dataset build. Cached only so the build is
# resumable and a re-run costs the provider nothing; the dataset built from them
# is what matters and is committed.
data/ml/cache/

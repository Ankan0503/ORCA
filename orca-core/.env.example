# Copy to .env and fill in. Never commit .env.

# Groq plans and reasons. Without it the orchestrator falls back to its
# rule-based planner rather than failing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Sarvam handles the language edges: speech in, speech out, translation.
SARVAM_API_KEY=

# This service runs alongside the originals rather than replacing them yet.
#   backend/            -> 8000
#   HackHeritage        -> 3001 (web) + 8000/8001 (its Python services)
#   orca-core           -> 8100
PORT=8100

ARCHIVE_ENABLED=true
